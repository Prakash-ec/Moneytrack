# Copy this file to backend/.env to override defaults.
# Do not commit backend/.env or the database file.

# SQLite (default). Use forward slashes on Windows.
# DATABASE_URL=sqlite:///D:/MoneyTrack/backend/data/moneytrack.db

# Future PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://moneytrack:change-me@localhost:5432/moneytrack

# Direct browser origins allowed to call the API. The Vite proxy does not need CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,http://localhost,capacitor://localhost
# For the Android app (WebView) calling the API over a trusted local network,
# set CORS_ORIGINS=* . Only use "*" on a private network that is not exposed
# to the public internet.
# CORS_ORIGINS=*

# Set to false if you do not want FastAPI to serve frontend/dist.
SERVE_FRONTEND=true

# ---------------------------------------------------------------------------
# Groq vision (optional AI receipt analysis)
# ---------------------------------------------------------------------------
# Get a key from https://console.groq.com and set it here. NEVER commit this file.
# Leave unset / empty to disable Groq and fall back to local Tesseract OCR only.
GROQ_API_KEY=
# Optional secondary Groq account key used only when the primary key is
# rate-limited (HTTP 429) or temporarily unavailable (HTTP 5xx / timeout).
GROQ_API_KEY_FALLBACK=

# Image-capable Qwen model on Groq. Override only if Groq retires the model.
# See https://console.groq.com/docs/models for currently available vision models.
GROQ_MODEL=qwen/qwen3.8-27b

# Backend-only timeout (seconds) for Groq image analysis requests before falling
# back to Tesseract.
GROQ_REQUEST_TIMEOUT=20
