# Copy this file to backend/.env to override defaults.
# Do not commit backend/.env or your database credentials.

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# Local SQLite (default):
# DATABASE_URL=sqlite:///data/moneytrack.db

# Production Neon PostgreSQL (Free plan):
# Note: Both postgres:// and postgresql:// prefixes are automatically converted to
# postgresql+psycopg2:// at runtime. sslmode=require is required for Neon connections.
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-silent-frost-b5ee0dqt.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Server & Port Configuration
# ---------------------------------------------------------------------------
# Render automatically injects the $PORT environment variable.
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ---------------------------------------------------------------------------
# Direct browser origins allowed to call the API.
# Accepts either CORS_ORIGINS or ALLOWED_ORIGINS. Set to '*' or comma-separated list:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,http://localhost,capacitor://localhost

# ---------------------------------------------------------------------------
# Frontend Serving Mode
# ---------------------------------------------------------------------------
# Set to false on Render if deploying frontend as a separate Static Site (Recommended).
# Set to true if FastAPI serves built frontend/dist assets directly.
SERVE_FRONTEND=false

# ---------------------------------------------------------------------------
# Groq vision (optional AI receipt analysis)
# ---------------------------------------------------------------------------
# Get a key from https://console.groq.com and set it here. NEVER commit this file.
# Leave unset / empty to disable Groq and fall back to local Tesseract OCR only.
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REQUEST_TIMEOUT=20
