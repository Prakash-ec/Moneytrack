# Bandit Security Scanner Configuration for MoneyTrack (YAML format)
exclude_dirs:
  - "/tests"
  - "/alembic"
  - "/.venv"
# B104: Binding to 0.0.0.0 is intentional and necessary for containerized hosting on Render / Docker.
# B105: Development fallback placeholder secret key in config.py
# B106: False positive on standard OAuth2 / JWT bearer token string literal ("bearer").
# B110: Try-except-pass blocks in non-critical cleanup/metrics blocks.
# B404/B603: Safe local Tesseract OCR subprocess call with explicit binary path.
skips:
  - "B104"
  - "B105"
  - "B106"
  - "B110"
  - "B404"
  - "B603"
