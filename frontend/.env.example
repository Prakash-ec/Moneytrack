# Default: the frontend calls /api, which Vite proxies to the FastAPI backend
# during development and is same-origin when FastAPI serves frontend/dist.
# Only set this when the API is hosted elsewhere (e.g. Render production deployment).
# VITE_API_BASE_URL=https://moneytrack-backend-g5is.onrender.com/api

# Optional: where the Vite dev proxy sends /api requests during local development.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
